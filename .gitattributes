# 文本文件：仓库里统一用 LF（Windows 检出时由 core.autocrlf 决定工作区形态）
* text=auto
*.py   text
*.md   text
*.txt  text
*.csv  text
*.tsv  text
*.json text
*.html text
*.iss  text
*.ps1  text
*.spec text
*.toml text
*.sh   text eol=lf
# Windows 批处理必须是 CRLF，否则 cmd 解析会出问题
*.bat  text eol=crlf
# 二进制：不做任何行尾转换
*.png  -text
*.jpg  -text
*.jpeg -text
*.ico  -text
*.gif  -text
*.nc   -text
*.npz  -text
*.npy  -text
*.gfc  -text
*.grd  -text
*.exe  -text
